/// Personal access token for external clients (the OpenAthlete MCP server).
/// Only a SHA-256 hash is stored; the token is shown once at creation.
/// Read-only: it can call the data tools endpoints and nothing else.
model PersonalAccessToken {
  personalAccessTokenId Int       @id @default(autoincrement()) @map("personal_access_token_id")
  name                  String
  /// SHA-256 hex digest of the token
  tokenHash             String    @unique @map("token_hash")
  /// First characters, to recognise the token in lists
  prefix                String
  lastUsedAt            DateTime? @map("last_used_at")
  expiresAt             DateTime? @map("expires_at")
  revokedAt             DateTime? @map("revoked_at")
  user                  User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId                Int       @map("user_id")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("personal_access_token")
}
