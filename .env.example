# =============================================================================
# OpenAthlete - Docker Compose configuration
# =============================================================================
# docker compose reads this file as `.env` in the repository root:
#
#   cp .env.example .env
#
# Every API variable is documented in apps/api/.env.example; the ones below
# are those docker-compose.yml passes to the containers.
# =============================================================================

# -----------------------------------------------------------------------------
# Required secrets
# -----------------------------------------------------------------------------

# Signs login sessions. Generate with: openssl rand -base64 48
JWT_SECRET_KEY=

# Mixed into password hashes. Generate with: openssl rand -base64 48
# Never change it once accounts exist: every existing password would stop
# working. If your instance was started with the former built-in default,
# keep that value: HASH_PEPPER=dev-pepper-change-in-production-min-32-chars
HASH_PEPPER=

# -----------------------------------------------------------------------------
# Public URLs
# -----------------------------------------------------------------------------

# Where users open the web app (used in email links)
APP_URL=http://localhost
# Where browsers reach the API (applied when the web container starts)
API_PUBLIC_URL=http://localhost:3000
# Origins allowed to call the API (the web app URL)
CORS_ORIGINS=http://localhost

# Host ports (defaults: web 80, API 3000)
# WEB_PORT=80
# API_PORT=3000

# -----------------------------------------------------------------------------
# Optional features (leave empty to disable)
# -----------------------------------------------------------------------------

# AI: users add their own provider keys in Settings > AI. Keys set here are
# the instance's ("hosted AI"), shared with every user unless AI_HOSTED_ACCESS
# says otherwise. Models are provider/model, e.g. anthropic/claude-sonnet-4-5.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# One model for every AI feature on the instance keys
# (default: openai/gpt-5.6-luna)
AI_MODEL_DEFAULT=
# everyone (default without Stripe), subscribers, or none
AI_HOSTED_ACCESS=
# What each user may spend per month on the instance keys, in US dollars
# (empty: no limit)
AI_HOSTED_MONTHLY_BUDGET_USD=
# Let users add OpenAI-compatible endpoints by URL, such as a local Ollama
# (default: true without Stripe)
AI_ALLOW_CUSTOM_ENDPOINTS=
# Transactional email
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# Device integrations: see apps/api/.env.example for redirect URIs
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
SUUNTO_CLIENT_ID=
SUUNTO_CLIENT_SECRET=
SUUNTO_SUBSCRIPTION_KEY=

# Background jobs, run by the API container. Import and processing are needed
# for device sync (Strava, Garmin...) to bring activities in.
ENABLE_ACTIVITY_IMPORT=true
ENABLE_ACTIVITY_PROCESSING=true
# Estimates the load of planned sessions with AI (needs an AI key)
ENABLE_TRAINING_LOAD_ESTIMATION=false
