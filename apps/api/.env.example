# =============================================================================
# OpenAthlete API - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
#
# Documentation: https://github.com/tristanblt/openathlete/blob/main/CONTRIBUTING.md
# =============================================================================

# -----------------------------------------------------------------------------
# Application Core
# -----------------------------------------------------------------------------

# Application environment: 'development' | 'staging' | 'production'
ENV=development

# Node environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Server port (default: 3000)
PORT=3000

# Base URL of the application (used for generating links in emails, etc.)
# Example: http://localhost:5173 (dev) or https://app.openathlete.org (prod)
APP_URL=http://localhost:5173

# CORS allowed origins (comma-separated)
# For development, include: http://localhost:5173,capacitor://localhost
# For production, include your production domains
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost,https://localhost

# Which reverse proxies to trust for the client IP (used by rate limiting).
# Default: proxies on private networks (Docker, Traefik, Coolify). Set a hop
# count (e.g. 2) when another public proxy such as Cloudflare sits in front.
# TRUST_PROXY=loopback,linklocal,uniquelocal

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------

# JWT secret key for signing tokens (use a strong random string)
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# Pepper for password hashing (additional security layer)
# Generate with: openssl rand -base64 16
HASH_PEPPER=your-hash-pepper-change-this-in-production

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?schema=public
# The default matches the PostgreSQL service of docker-compose.dev.yml
# (docker compose -f docker-compose.dev.yml up -d)
DATABASE_URL=postgresql://openathlete:openathlete_dev_password@localhost:5433/openathlete?schema=public

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Redis connection URL (used for queues, caching, Socket.IO adapter)
# Format: redis://[:password@]host[:port][/database]
# Example: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Email (Brevo, Optional)
# -----------------------------------------------------------------------------

# Brevo (formerly Sendinblue) API key for sending emails
# Get it from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key

# Email address to send emails from (must be verified in Brevo)
BREVO_FROM_EMAIL=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Strava Integration (Optional)
# -----------------------------------------------------------------------------

# Strava OAuth credentials
# Create an app at: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret

# Strava OAuth redirect URI (must match your Strava app settings)
# Format: {APP_URL}/auth/callback/strava
STRAVA_REDIRECT_URI=http://localhost:5173/auth/callback/strava

# Strava webhook verification token (random string)
# Used to verify webhook requests from Strava
STRAVA_WEBHOOK_TOKEN=your-strava-webhook-token

# -----------------------------------------------------------------------------
# Garmin Integration (Optional)
# -----------------------------------------------------------------------------

# Garmin Connect IQ OAuth credentials
# Register at: https://developer.garmin.com/connect-iq/developer-tools/
GARMIN_CLIENT_ID=your-garmin-client-id
GARMIN_CLIENT_SECRET=your-garmin-client-secret

# Garmin OAuth redirect URI
# Format: {APP_URL}/auth/callback/garmin
GARMIN_REDIRECT_URI=http://localhost:5173/auth/callback/garmin

# -----------------------------------------------------------------------------
# Polar Integration (Optional)
# -----------------------------------------------------------------------------

# Polar OAuth credentials
# Register at: https://www.polar.com/accesslink
POLAR_CLIENT_ID=your-polar-client-id
POLAR_CLIENT_SECRET=your-polar-client-secret

# Polar OAuth redirect URI
# Format: {APP_URL}/auth/callback/polar
POLAR_REDIRECT_URI=http://localhost:5173/auth/callback/polar

# Polar webhook URL (where Polar will send webhook events)
# Format: {API_URL}/provider/polar/webhook
POLAR_WEBHOOK_URL=http://localhost:3000/provider/polar/webhook

# Polar webhook secret key (for verifying webhook requests)
POLAR_WEBHOOK_SECRET_KEY=your-polar-webhook-secret-key

# -----------------------------------------------------------------------------
# Suunto Integration (Optional)
# -----------------------------------------------------------------------------

# Suunto OAuth credentials
# Register at: https://www.suunto.com/developer/
SUUNTO_CLIENT_ID=your-suunto-client-id
SUUNTO_CLIENT_SECRET=your-suunto-client-secret

# Suunto OAuth redirect URI
# Format: {APP_URL}/auth/callback/suunto
SUUNTO_REDIRECT_URI=http://localhost:5173/auth/callback/suunto

# Suunto subscription key (for API access)
SUUNTO_SUBSCRIPTION_KEY=your-suunto-subscription-key

# -----------------------------------------------------------------------------
# Coros Integration (Optional)
# -----------------------------------------------------------------------------

# Coros OAuth credentials
# Register at: https://open.coros.com/
COROS_CLIENT_ID=your-coros-client-id
COROS_CLIENT_SECRET=your-coros-client-secret

# Coros OAuth redirect URI
# Format: {APP_URL}/auth/callback/coros
COROS_REDIRECT_URI=http://localhost:5173/auth/callback/coros

# -----------------------------------------------------------------------------
# AI (optional)
# -----------------------------------------------------------------------------
# Users bring their own provider keys and models (Settings > AI). Keys below
# are the instance's ("hosted AI"): any provider's standard variable works
# (OPENAI_API_KEY, ANTHROPIC_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY,
# MISTRAL_API_KEY, OPENROUTER_API_KEY...).
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Instance models, as provider/model. AI_MODEL_DEFAULT applies to every
# feature without its own variable.
# AI_MODEL_DEFAULT=openai/gpt-5.6-luna
# AI_MODEL_EVENT_GENERATION=
# AI_MODEL_EVENT_MODIFICATION=
# AI_MODEL_POST_ACTIVITY_FEEDBACK=
# AI_MODEL_FEEDBACK_EXTRACTION=
# AI_MODEL_TRIMP_ESTIMATION=
# Coach features; unset, they use AI_MODEL_EVENT_MODIFICATION.
# AI_MODEL_PLAN_GENERATION=
# AI_MODEL_PLAN_ADAPTATION=
# AI_MODEL_ACTIVITY_ANALYSIS=

# Who may use the instance keys: everyone, subscribers (paid plan with AI) or
# none. Default: subscribers when Stripe is configured, everyone otherwise.
# AI_HOSTED_ACCESS=

# What each user may spend per month on the instance keys, in US dollars at
# the providers' prices (e.g. 3). Users with their own key are not limited.
# Unset: no limit.
# AI_HOSTED_MONTHLY_BUDGET_USD=

# Let users add OpenAI-compatible endpoints by URL (Ollama, vLLM, LM Studio).
# The server calls these URLs: keep it off on public instances. Default: on
# without Stripe, off with Stripe.
# AI_ALLOW_CUSTOM_ENDPOINTS=

# Anthropic API key (to use Claude as the AI provider)
# Get it from: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Default provider of the instance models: openai (default) or anthropic.
# With anthropic, every feature uses anthropic/claude-opus-5 unless overridden,
# and the small-model features below use anthropic/claude-haiku-4-5.
# AI_PROVIDER=anthropic

# Claude has no audio input. Voice note transcription uses OpenAI by default;
# set this to google to use GOOGLE_GENERATIVE_AI_API_KEY instead (the API logs
# a warning at startup explaining the trade-offs).
# AI_TRANSCRIPTION_PROVIDER=google
# AI_MODEL_TRANSCRIPTION=gemini-2.5-flash

# Coach AI memory (enabled per athlete by the coach) consolidates notes every
# few AI results with this model. A small model is enough, so AI_MODEL_DEFAULT
# does not apply here.
# AI_MODEL_MEMORY=openai/gpt-4o-mini

# Converting a workout written in words into steps uses a small model too
# (AI_MODEL_DEFAULT does not apply either).
# AI_MODEL_WORKOUT_PARSER=openai/gpt-5-mini

# Per-agent model overrides use the provider/model format, e.g.
# openai/gpt-5.1, google/gemini-3-pro-preview or anthropic/claude-opus-5.
# Feedback questions default to Google; select OpenAI explicitly when using its key.
# AI_MODEL_POST_ACTIVITY_FEEDBACK=openai/gpt-5.1

# -----------------------------------------------------------------------------
# AI Services
# -----------------------------------------------------------------------------

# Error monitoring with a Sentry-compatible DSN (optional)
BETTER_STACK_DSN=https://dsn@zone.betterstackdata.com/id
# Share of requests traced, between 0 and 1 (default 0.1)
# SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Stripe (Optional - billing is disabled when STRIPE_SECRET_KEY is unset)
# -----------------------------------------------------------------------------

# Stripe secret key (for server-side operations)
# Get it from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Stripe publishable key (for client-side operations)
# Get it from: https://dashboard.stripe.com/apikeys
# STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Stripe webhook secret (for verifying webhook events)
# Get it from: https://dashboard.stripe.com/webhooks
# STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Prices of the Supporter subscription, the only paid plan (5 EUR per month,
# 50 EUR per year). Without Stripe, nothing is sold and no limit applies.
# STRIPE_PRICE_SUPPORTER_MONTHLY=price_xxx
# STRIPE_PRICE_SUPPORTER_YEARLY=price_yyy

# -----------------------------------------------------------------------------
# Firebase (Optional)
# -----------------------------------------------------------------------------

# Firebase Functions URL (for push notifications)
# Format: https://your-region-your-project.cloudfunctions.net
FIREBASE_FUNCTIONS_URL=https://your-region-your-project.cloudfunctions.net

# Firebase Service Account JSON
FIREBASE_SERVICE_ACCOUNT_JSON='{}'

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------

# Enable activity import from providers (true/false)
# Set to false to disable automatic activity imports
ENABLE_ACTIVITY_IMPORT=true

# Enable activity processing (GPX parsing, metrics calculation, etc.)
# Set to false to disable processing pipeline
ENABLE_ACTIVITY_PROCESSING=true

# Enable AI-powered training load estimation (requires OpenAI API key)
# Set to false to disable this feature
ENABLE_TRAINING_LOAD_ESTIMATION=true

# Disable billing and enable AI access for authenticated users on your own server.
# LLM provider credentials are still required. Default: false.
SELF_HOSTED=false

# Optional manual activity tools. Both default to false for a clean installation.
# These flags affect all users and block the corresponding API operations when disabled.
# Official Garmin/Strava connections and existing activities are unchanged.
ENABLE_MANUAL_FIT_IMPORT=false
ENABLE_MANUAL_GARMIN_SYNC=false

# Manual Garmin also requires SELF_HOSTED=true and this absolute scripts/garmin-probe path.
# GARMIN_UNOFFICIAL_DIRECTORY=

# Account administrators (OA user IDs, comma-separated). Empty disables admin access.
ADMIN_USER_IDS=
